#!/usr/bin/env -S uv --quiet run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Drive a Makepad app via the Studio bridge websocket.

Sends mouse, keyboard, touch input and takes screenshots.
For webview-level JS eval, use havi-webview-remote-cli.
"""

import argparse, hashlib, json, os, queue, re, shutil, socket, struct
import subprocess, sys, threading, time

# ---------------------------------------------------------------------------
# Makepad KeyCode index table (matches KEYCODE_VARIANTS in keyboard.rs)
# ---------------------------------------------------------------------------

KEYCODE_VARIANTS = [
    "Escape", "Back", "Backtick",
    "Key0", "Key1", "Key2", "Key3", "Key4", "Key5", "Key6", "Key7", "Key8", "Key9",
    "Minus", "Equals", "Backspace", "Tab",
    "KeyQ", "KeyW", "KeyE", "KeyR", "KeyT", "KeyY", "KeyU", "KeyI", "KeyO", "KeyP",
    "LBracket", "RBracket", "ReturnKey",
    "KeyA", "KeyS", "KeyD", "KeyF", "KeyG", "KeyH", "KeyJ", "KeyK", "KeyL",
    "Semicolon", "Quote", "Backslash",
    "KeyZ", "KeyX", "KeyC", "KeyV", "KeyB", "KeyN", "KeyM",
    "Comma", "Period", "Slash",
    "Control", "Alt", "Shift", "Logo",
    "Space", "Capslock",
    "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12",
    "PrintScreen", "ScrollLock", "Pause",
    "Insert", "Delete", "Home", "End", "PageUp", "PageDown",
    "Numpad0", "Numpad1", "Numpad2", "Numpad3", "Numpad4",
    "Numpad5", "Numpad6", "Numpad7", "Numpad8", "Numpad9",
    "NumpadEquals", "NumpadSubtract", "NumpadAdd", "NumpadDecimal",
    "NumpadMultiply", "NumpadDivide", "Numlock", "NumpadEnter",
    "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight",
    "Unknown",
]

KEY_MAP = {
    "enter": "ReturnKey", "tab": "Tab", "escape": "Escape",
    "backspace": "Backspace", "delete": "Delete",
    "up": "ArrowUp", "down": "ArrowDown", "left": "ArrowLeft", "right": "ArrowRight",
    "home": "Home", "end": "End", "pageup": "PageUp", "pagedown": "PageDown",
    "space": "Space",
    **{c: f"Key{c.upper()}" for c in "abcdefghijklmnopqrstuvwxyz"},
    **{d: f"Key{d}" for d in "0123456789"},
}

MODS = {"shift": False, "control": False, "alt": False, "logo": False}

last_pos = [0.0, 0.0]

# ---------------------------------------------------------------------------
# Raw websocket over TCP (follows cargo-makepad studio.rs approach)
# ---------------------------------------------------------------------------

def ws_connect(host, port, path="/$studio_terminal"):
    """Open a websocket connection. Returns (socket, reader_thread, rx_queue)."""
    sock = socket.create_connection((host, port), timeout=10)
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)

    import base64
    ws_key = base64.b64encode(hashlib.sha1(b"havi-remote-cli").digest()).decode()
    req = (
        f"GET {path} HTTP/1.1\r\n"
        f"Host: {host}:{port}\r\n"
        f"Connection: Upgrade\r\n"
        f"Upgrade: websocket\r\n"
        f"Sec-WebSocket-Version: 13\r\n"
        f"Sec-WebSocket-Key: {ws_key}\r\n"
        f"\r\n"
    )
    sock.sendall(req.encode())

    buf = b""
    deadline = time.monotonic() + 5
    while b"\r\n\r\n" not in buf:
        if time.monotonic() > deadline:
            raise TimeoutError("websocket handshake timeout")
        chunk = sock.recv(4096)
        if not chunk:
            raise ConnectionError("closed during handshake")
        buf += chunk

    header_end = buf.index(b"\r\n\r\n") + 4
    status_line = buf[:buf.index(b"\r\n")].decode()
    if "101" not in status_line:
        raise ConnectionError(f"upgrade rejected: {status_line}")
    leftover = buf[header_end:]

    rx = queue.Queue()
    reader = threading.Thread(target=_ws_reader, args=(sock, rx, leftover), daemon=True)
    reader.start()
    return sock, reader, rx


def _ws_reader(sock, rx, leftover):
    """Background: read websocket frames, put parsed JSON into rx queue."""
    buf = bytearray(leftover)
    try:
        while True:
            while True:
                frame = _try_parse_frame(buf)
                if frame is not None:
                    opcode, payload = frame
                    if opcode in (0x1, 0x2):  # text or binary
                        try:
                            text = payload if isinstance(payload, str) else payload.decode("utf-8", errors="replace")
                            rx.put(json.loads(text))
                        except (json.JSONDecodeError, UnicodeDecodeError):
                            pass
                    elif opcode == 0x8:
                        return
                    elif opcode == 0x9:
                        _ws_send_pong(sock, payload)
                    break
                try:
                    chunk = sock.recv(65536)
                except OSError:
                    return
                if not chunk:
                    return
                buf.extend(chunk)
    except Exception:
        pass


def _try_parse_frame(buf):
    """Parse one websocket frame from buf. Returns (opcode, payload) or None."""
    if len(buf) < 2:
        return None
    b0, b1 = buf[0], buf[1]
    opcode = b0 & 0x0F
    masked = b1 & 0x80
    payload_len = b1 & 0x7F
    offset = 2
    if payload_len == 126:
        if len(buf) < 4: return None
        payload_len = struct.unpack(">H", buf[2:4])[0]
        offset = 4
    elif payload_len == 127:
        if len(buf) < 10: return None
        payload_len = struct.unpack(">Q", buf[2:10])[0]
        offset = 10
    if masked:
        mask_offset = offset
        offset += 4
    else:
        mask_offset = None
    if len(buf) < offset + payload_len:
        return None
    payload = bytes(buf[offset:offset + payload_len])
    if mask_offset is not None:
        mask = buf[mask_offset:mask_offset + 4]
        payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    del buf[:offset + payload_len]
    if opcode == 0x1:
        payload = payload.decode("utf-8", errors="replace")
    return (opcode, payload)


def _ws_send_frame(sock, opcode, payload):
    """Send a masked websocket frame."""
    if isinstance(payload, str):
        payload = payload.encode()
    header = bytearray()
    header.append(0x80 | opcode)
    length = len(payload)
    if length < 126:
        header.append(0x80 | length)
    elif length < 65536:
        header.append(0x80 | 126)
        header.extend(struct.pack(">H", length))
    else:
        header.append(0x80 | 127)
        header.extend(struct.pack(">Q", length))
    header.extend(b"\x00\x00\x00\x00")  # zero mask
    sock.sendall(bytes(header) + payload)


def _ws_send_pong(sock, payload):
    _ws_send_frame(sock, 0xA, payload)


def ws_send(sock, msg):
    """Send a JSON message."""
    _ws_send_frame(sock, 0x1, json.dumps(msg))


def ws_recv(rx, match_fn=None, timeout=30):
    """Wait for a matching message from the queue."""
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None
        try:
            msg = rx.get(timeout=min(remaining, 0.5))
        except queue.Empty:
            continue
        if match_fn is None or match_fn(msg):
            return msg


def ws_send_recv(sock, rx, msg, match_fn=None, timeout=30):
    """Send msg and wait for a matching response."""
    ws_send(sock, msg)
    return ws_recv(rx, match_fn, timeout)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def keycode_index(name):
    code = KEY_MAP.get(name.lower(), name)
    try:
        return KEYCODE_VARIANTS.index(code)
    except ValueError:
        return KEYCODE_VARIANTS.index("Unknown")


def discover_build_id(sock, rx):
    resp = ws_send_recv(sock, rx, {"ListBuilds": []},
                        match_fn=lambda m: "Builds" in m)
    if not resp:
        sys.exit("error: ListBuilds timeout")
    builds = resp["Builds"]["builds"]
    for b in builds:
        if b.get("active") and b.get("has_web_socket"):
            return b["build_id"]
    for b in builds:
        if b.get("active"):
            return b["build_id"]
    if builds:
        return builds[0]["build_id"]
    sys.exit("error: no builds found")


def get_build_id(args, sock, rx):
    if args.build_id is not None:
        return args.build_id
    return discover_build_id(sock, rx)

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_click(args, sock, rx, bid):
    x, y = int(args.x), int(args.y)
    last_pos[0], last_pos[1] = x, y
    ws_send(sock, {"Click": {"build_id": bid, "x": x, "y": y}})


def cmd_type(args, sock, rx, bid):
    text = " ".join(args.text)
    ws_send(sock, {"TypeText": {"build_id": bid, "text": text}})


def cmd_key(args, sock, rx, bid):
    name = args.name
    if name.lower() == "enter":
        ws_send(sock, {"Return": {"build_id": bid}})
        return
    idx = keycode_index(name)
    kd = {"key_code": idx, "is_repeat": False, "modifiers": MODS, "time": 0.0}
    ws_send(sock, {"StudioToApp": {"build_id": bid, "msg": {"KeyDown": [kd]}}})
    char = name if len(name) == 1 else {"space": " "}.get(name.lower())
    if char:
        ws_send(sock, {"StudioToApp": {"build_id": bid, "msg":
            {"TextInput": [{"input": char, "replace_last": False, "was_paste": False}]}}})
    ws_send(sock, {"StudioToApp": {"build_id": bid, "msg": {"KeyUp": [kd]}}})


def cmd_mousedown(args, sock, rx, bid):
    x, y = float(args.x), float(args.y)
    last_pos[0], last_pos[1] = x, y
    ws_send(sock, {"StudioToApp": {"build_id": bid, "msg":
        {"MouseDown": [{"button_raw_bits": 1, "x": x, "y": y,
                        "time": 0.0, "modifiers": MODS}]}}})


def cmd_mouseup(args, sock, rx, bid):
    x = float(args.x) if args.x is not None else last_pos[0]
    y = float(args.y) if args.y is not None else last_pos[1]
    last_pos[0], last_pos[1] = x, y
    ws_send(sock, {"StudioToApp": {"build_id": bid, "msg":
        {"MouseUp": [{"time": 0.0, "button_raw_bits": 1, "x": x, "y": y,
                      "modifiers": MODS}]}}})


def cmd_mousemove(args, sock, rx, bid):
    x, y = float(args.x), float(args.y)
    last_pos[0], last_pos[1] = x, y
    ws_send(sock, {"StudioToApp": {"build_id": bid, "msg":
        {"MouseMove": [{"time": 0.0, "x": x, "y": y, "modifiers": MODS}]}}})


def cmd_touch(args, sock, rx, bid):
    state_map = {"start": "Start", "down": "Start", "stop": "Stop",
                 "up": "Stop", "move": "Move", "stable": "Stable"}
    state_name = state_map.get(args.phase.lower())
    if not state_name:
        sys.exit(f"error: unknown touch phase: {args.phase}")
    ws_send(sock, {"StudioToApp": {"build_id": bid, "msg":
        {"TouchUpdate": [{"touches": [
            {"uid": args.id, "state": {state_name: []},
             "x": float(args.x), "y": float(args.y), "time": time.time(),
             "rotation_angle": 0.0, "force": 1.0,
             "radius_x": 0.0, "radius_y": 0.0}],
          "modifiers": MODS}]}}})


def cmd_screenshot(args, sock, rx, bid):
    resp = ws_send_recv(sock, rx,
        {"Screenshot": {"build_id": bid, "kind_id": 0}},
        match_fn=lambda m: "Screenshot" in m, timeout=30)
    if not resp or "Screenshot" not in resp:
        print(json.dumps(resp or {"error": "timeout"}))
        sys.exit(1)
    src = resp["Screenshot"]["path"]
    if src != args.path:
        shutil.copy2(src, args.path)
    try:
        subprocess.run(["magick", args.path, args.path], check=True,
                       capture_output=True, timeout=10)
    except (FileNotFoundError, subprocess.SubprocessError):
        pass
    print(json.dumps(resp))


def cmd_sleep(args, sock, rx, bid):
    time.sleep(args.ms / 1000.0)


def cmd_builds(args, sock, rx, bid):
    resp = ws_send_recv(sock, rx, {"ListBuilds": []},
                        match_fn=lambda m: "Builds" in m)
    if not resp:
        sys.exit("error: ListBuilds timeout")
    for b in resp["Builds"]["builds"]:
        flags = []
        if b.get("active"): flags.append("active")
        if b.get("has_web_socket"): flags.append("ws")
        f = " ".join(flags)
        print(f'{b["build_id"]} {b.get("package", "")} [{f}]')


def cmd_dump(args, sock, rx, bid):
    resp = ws_send_recv(sock, rx,
        {"WidgetTreeDump": {"build_id": bid}},
        match_fn=lambda m: "WidgetTreeDump" in m, timeout=30)
    if not resp or "WidgetTreeDump" not in resp:
        print(json.dumps(resp or {"error": "timeout"}))
        sys.exit(1)
    print(resp["WidgetTreeDump"]["dump"])


def cmd_query(args, sock, rx, bid):
    resp = ws_send_recv(sock, rx,
        {"WidgetQuery": {"build_id": bid, "query": args.query}},
        match_fn=lambda m: "WidgetQuery" in m, timeout=30)
    if not resp or "WidgetQuery" not in resp:
        print(json.dumps(resp or {"error": "timeout"}))
        sys.exit(1)
    for r in resp["WidgetQuery"]["rects"]:
        print(r)


def cmd_send(args, sock, rx, bid):
    msg = json.loads(args.json)
    resp = ws_send_recv(sock, rx, msg, timeout=30)
    if resp:
        print(json.dumps(resp))


def cmd_pipe(args, sock, rx, bid):
    """Read commands from stdin, one per line. Space-separated."""
    dispatch = {
        "click": lambda parts: cmd_click(
            argparse.Namespace(x=parts[0], y=parts[1]), sock, rx, bid),
        "type": lambda parts: cmd_type(
            argparse.Namespace(text=parts), sock, rx, bid),
        "key": lambda parts: cmd_key(
            argparse.Namespace(name=parts[0]), sock, rx, bid),
        "mousedown": lambda parts: cmd_mousedown(
            argparse.Namespace(x=parts[0], y=parts[1]), sock, rx, bid),
        "mouseup": lambda parts: cmd_mouseup(
            argparse.Namespace(x=parts[0] if parts else None,
                               y=parts[1] if len(parts) > 1 else None), sock, rx, bid),
        "mousemove": lambda parts: cmd_mousemove(
            argparse.Namespace(x=parts[0], y=parts[1]), sock, rx, bid),
        "touch": lambda parts: cmd_touch(
            argparse.Namespace(id=int(parts[0]), phase=parts[1],
                               x=parts[2], y=parts[3]), sock, rx, bid),
        "screenshot": lambda parts: cmd_screenshot(
            argparse.Namespace(path=parts[0]), sock, rx, bid),
        "sleep": lambda parts: cmd_sleep(
            argparse.Namespace(ms=int(parts[0])), sock, rx, bid),
        "dump": lambda parts: cmd_dump(
            argparse.Namespace(), sock, rx, bid),
        "query": lambda parts: cmd_query(
            argparse.Namespace(query=" ".join(parts)), sock, rx, bid),
        "send": lambda parts: cmd_send(
            argparse.Namespace(json=" ".join(parts)), sock, rx, bid),
    }
    try:
        for line in sys.stdin:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            cmd_name, cmd_args = parts[0], parts[1:]
            fn = dispatch.get(cmd_name)
            if fn:
                fn(cmd_args)
                time.sleep(0.02)
            else:
                print(f"error: unknown command: {cmd_name}", file=sys.stderr)
    except (EOFError, KeyboardInterrupt):
        pass

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(
        prog="havi-remote-cli",
        description="Drive a Makepad app via Studio bridge websocket.")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--port", type=int, default=8001)
    p.add_argument("--build-id", type=int, default=None)
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("click", help="Click at coordinates")
    s.add_argument("x", type=float)
    s.add_argument("y", type=float)
    s.set_defaults(func=cmd_click)

    s = sub.add_parser("type", help="Type text")
    s.add_argument("text", nargs="+")
    s.set_defaults(func=cmd_type)

    s = sub.add_parser("key", help="Press key (enter, tab, escape, a-z, ...)")
    s.add_argument("name")
    s.set_defaults(func=cmd_key)

    s = sub.add_parser("mousedown", help="Mouse button down")
    s.add_argument("x", type=float)
    s.add_argument("y", type=float)
    s.set_defaults(func=cmd_mousedown)

    s = sub.add_parser("mouseup", help="Mouse button up")
    s.add_argument("x", type=float, nargs="?", default=None)
    s.add_argument("y", type=float, nargs="?", default=None)
    s.set_defaults(func=cmd_mouseup)

    s = sub.add_parser("mousemove", help="Move mouse")
    s.add_argument("x", type=float)
    s.add_argument("y", type=float)
    s.set_defaults(func=cmd_mousemove)

    s = sub.add_parser("touch", help="Touch event")
    s.add_argument("id", type=int)
    s.add_argument("phase", choices=["start", "down", "stop", "up", "move", "stable"])
    s.add_argument("x", type=float)
    s.add_argument("y", type=float)
    s.set_defaults(func=cmd_touch)

    s = sub.add_parser("screenshot", help="Take screenshot")
    s.add_argument("path")
    s.set_defaults(func=cmd_screenshot)

    s = sub.add_parser("sleep", help="Wait milliseconds")
    s.add_argument("ms", type=int)
    s.set_defaults(func=cmd_sleep)

    s = sub.add_parser("builds", help="List active builds")
    s.set_defaults(func=cmd_builds)

    s = sub.add_parser("dump", help="Widget tree dump")
    s.set_defaults(func=cmd_dump)

    s = sub.add_parser("query", help="Query widget tree (id:name, type:name, or substring)")
    s.add_argument("query")
    s.set_defaults(func=cmd_query)

    s = sub.add_parser("send", help="Send raw JSON")
    s.add_argument("json")
    s.set_defaults(func=cmd_send)

    s = sub.add_parser("pipe", help="Read commands from stdin")
    s.set_defaults(func=cmd_pipe)

    args = p.parse_args()
    sock, _reader, rx = ws_connect(args.host, args.port)
    bid = get_build_id(args, sock, rx)
    args.func(args, sock, rx, bid)


if __name__ == "__main__":
    main()
