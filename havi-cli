#!/usr/bin/env -S uv --quiet run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""HAVI command-line interface.

Subcommand groups:
    makepad   Makepad UI control (mouse, keyboard, screenshot, dump)
    devtools  Servo webview control (JS eval, navigate, DOM screenshot)

Built-in commands:
    publish     Store signed file and navigate
    publish-dir Store directory tree and navigate
    deploy      Write deployment pointer for group/app
    navigate    Navigate HAVI to a URL

The makepad and devtools groups delegate to havi-makepad-cli and
havi-devtools-cli respectively. Those tools can also be used directly.

Examples:
    havi-cli makepad screenshot /tmp/out.png
    havi-cli makepad click 300 400
    havi-cli devtools eval 'document.title'
    havi-cli deploy u web //u/web V.EXAMPLE.H3
    havi-cli publish //u/web/index.html page.html
"""

import mimetypes, os, subprocess, sys


def _run(cmd, **kwargs):
    """Run a subprocess, exit on failure."""
    r = subprocess.run(cmd, **kwargs)
    if r.returncode != 0:
        name = cmd[0] if isinstance(cmd, list) else cmd
        sys.exit(f"error: {name} failed (exit {r.returncode})")
    return r


def _parse_coordinate(coord):
    """Parse //group/app/location into (group, app, location)."""
    if not coord.startswith("//"):
        sys.exit(f"error: coordinate must start with //: {coord}")
    parts = coord[2:].split("/", 2)
    if len(parts) < 2:
        sys.exit(f"error: coordinate must have at least group and app: {coord}")
    return parts[0], parts[1], parts[2] if len(parts) > 2 else ""


def _debug_port():
    """Resolve debug port from environment."""
    port = os.environ.get("HAVI_DEVTOOLS")
    if not port:
        sys.exit("error: set HAVI_DEVTOOLS")
    if ":" in port:
        port = port.rsplit(":", 1)[1]
    return str(port)


def cmd_navigate(args):
    port = _debug_port()
    _run(["havi-devtools-cli", "-p", port, "navigate", args[0]])


def cmd_deploy(args):
    if len(args) < 4:
        sys.exit("usage: havi-cli deploy <group> <app> <deploy-root> <deploy-signer>")
    group, app, deploy_root, deploy_signer = args[0], args[1], args[2], args[3]
    if not deploy_root.startswith("//"):
        sys.exit("error: deploy-root must start with //")
    if not (deploy_signer.startswith("V.") and deploy_signer.endswith(".H3")):
        sys.exit("error: deploy-signer must be V.<...>.H3")

    _run([
        "hppr", "add", "--seal-by", "oldest",
        f"//{group}/admin/deploy/{app}",
        "-H", f"Deploy-Root: {deploy_root}",
        "-H", f"Deploy-Signer: {deploy_signer}",
    ])


def cmd_publish(args):
    if len(args) < 2:
        sys.exit("usage: havi-cli publish <coordinate> <file>")
    coordinate, filepath = args[0], args[1]
    content_type = mimetypes.guess_type(filepath)[0] or "application/octet-stream"
    with open(filepath, "rb") as f:
        _run(["hppr", "add", "--seal-by", "oldest",
              "-H", f"Content-Type: {content_type}",
              coordinate], stdin=f)
    port = _debug_port()
    _run(["havi-devtools-cli", "-p", port, "navigate", f"hppr://{coordinate[2:]}"])


def cmd_publish_dir(args):
    if len(args) < 2:
        sys.exit("usage: havi-cli publish-dir <coordinate> <dir>")
    coordinate, dirpath = args[0], args[1]
    _run(["dir-pac", "--server-side", dirpath, coordinate])
    group, app, _ = _parse_coordinate(coordinate)
    port = _debug_port()
    _run(["havi-devtools-cli", "-p", port, "navigate", f"hppr://{group}/{app}/"])


BUILTIN = {
    "navigate": cmd_navigate,
    "deploy": cmd_deploy,
    "publish": cmd_publish,
    "publish-dir": cmd_publish_dir,
}

USAGE = """\
usage: havi-cli <command> [args...]

Subcommand groups (delegate to standalone tools):
    makepad <cmd> ...    Makepad UI control (havi-makepad-cli)
    devtools <cmd> ...   Servo webview control (havi-devtools-cli)

Built-in commands:
    navigate <url>                                         Navigate HAVI to a URL
    deploy <group> <app> <deploy-root> <deploy-signer>    Write deployment pointer
    publish <coordinate> <file>                            Store signed file, navigate
    publish-dir <coordinate> <dir>                         Store directory tree, navigate

Examples:
    havi-cli makepad screenshot /tmp/out.png
    havi-cli makepad click 300 400
    havi-cli devtools eval 'document.title'
    havi-cli deploy u web //u/web V.EXAMPLE.H3
    havi-cli publish //u/web/index.html page.html
"""


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(USAGE)
        sys.exit(0)

    cmd = args[0]
    rest = args[1:]

    if cmd == "makepad":
        os.execvp("havi-makepad-cli", ["havi-makepad-cli"] + rest)

    if cmd == "devtools":
        os.execvp("havi-devtools-cli", ["havi-devtools-cli"] + rest)

    if cmd in BUILTIN:
        BUILTIN[cmd](rest)
    else:
        print(f"error: unknown command: {cmd}", file=sys.stderr)
        print(USAGE, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
