#!/usr/bin/env -S uv --quiet run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""HAVI command-line interface.

Subcommand groups:
    makepad   Makepad UI control (mouse, keyboard, screenshot, dump)
    devtools  Servo webview control (JS eval, navigate, DOM screenshot)

Built-in commands:
    publish     Store signed file and navigate
    publish-dir Retired. Use hppr-fuse or hppr-nfs directly
    deploy      Write API content pointer for group/api
    navigate    Navigate HAVI to a URL

Direct open:
    //<group>/<api>//<key> [--shadow] [--mount PATH]

The makepad and devtools groups delegate to havi-makepad-cli and
havi-devtools-cli respectively. Those tools can also be used directly.

Examples:
    havi-cli makepad screenshot /tmp/out.png
    havi-cli makepad click 300 400
    havi-cli devtools eval 'document.title'
    havi-cli deploy u web //u/web// V.EXAMPLE.H3
    havi-cli publish //u/web//index.html page.html
"""

import mimetypes, os, shlex, sqlite3, subprocess, sys


def _run(cmd, **kwargs):
    """Run a subprocess, exit on failure."""
    r = subprocess.run(cmd, **kwargs)
    if r.returncode != 0:
        name = cmd[0] if isinstance(cmd, list) else cmd
        sys.exit(f"error: {name} failed (exit {r.returncode})")
    return r


def _parse_coordinate(coord):
    """Parse //group/api//key into (group, api, key)."""
    if not coord.startswith("//"):
        sys.exit(f"error: coordinate must start with //: {coord}")
    try:
        group_api, key = coord[2:].split("//", 1)
        group, api = group_api.split("/", 1)
    except ValueError:
        sys.exit(f"error: coordinate must be //group/api//key: {coord}")
    if not group or not api or not key:
        sys.exit(f"error: coordinate must have group, api, and key: {coord}")
    return group, api, key


def _shadow_root(coord):
    group, api, _ = _parse_coordinate(coord)
    return f"//~{group}/{api}//"


def _config_dir():
    return os.environ.get("HAVI_CONFIG") or os.path.expanduser("~/.config/HAVI")


def _state_db_path():
    return os.path.join(_config_dir(), "havi.sqlite")


def _shadow_signing_key(coord):
    import time

    group, api, _ = _parse_coordinate(coord)
    deadline = time.time() + 5.0
    while True:
        conn = sqlite3.connect(_state_db_path())
        try:
            row = conn.execute(
                "SELECT signing_key FROM shadow_keys WHERE group_name = ? AND app_name = ?",
                (group, api),
            ).fetchone()
        finally:
            conn.close()
        if row:
            return row[0]
        if time.time() >= deadline:
            sys.exit(f"error: no shadow key stored for //{group}/{api}")
        time.sleep(0.1)


def _admin_signer():
    conn = sqlite3.connect(_state_db_path())
    try:
        row = conn.execute(
            "SELECT ring1_name, token FROM credentials ORDER BY repo_vkey LIMIT 1"
        ).fetchone()
    finally:
        conn.close()
    if row:
        return f"ring1:{row[0]}|{row[1]}"
    return "ring1:ring0|init"


def _debug_port():
    """Resolve debug port from environment."""
    port = os.environ.get("HAVI_DEVTOOLS")
    if not port:
        sys.exit("error: set HAVI_DEVTOOLS")
    if ":" in port:
        port = port.rsplit(":", 1)[1]
    return str(port)


def _hppr_add(coordinate, headers, stdin=None):
    cmd = ["hppr", "add", "--seal-by", "ring0"]
    for header in headers:
        cmd.extend(["-H", header])
    cmd.append(coordinate)
    _run(cmd, stdin=stdin)


def cmd_navigate(args):
    port = _debug_port()
    _run(["havi-devtools-cli", "-p", port, "navigate", args[0]])


def cmd_open_target(args):
    if not args:
        sys.exit("usage: havi-cli //<group>/<api>//<key> [--shadow] [--mount PATH]")

    coord = args[0]
    shadow = False
    mountpoint = None
    i = 1
    while i < len(args):
        arg = args[i]
        if arg == "--shadow":
            shadow = True
        elif arg == "--mount":
            i += 1
            if i >= len(args):
                sys.exit("error: --mount requires a path")
            mountpoint = args[i]
        else:
            sys.exit(f"error: unknown argument: {arg}")
        i += 1

    group, api, key = _parse_coordinate(coord)
    url = f"hppr://{group}/{api}//{key}"

    cmd_navigate([url])

    if not shadow:
        return

    if not os.environ.get("HAVI_MAKEPAD_SOCKET"):
        sys.exit("error: --shadow requires HAVI_MAKEPAD_SOCKET")

    _run(["havi-makepad-cli", "control", "shadow_control", "enter"])

    if mountpoint:
        root = _shadow_root(coord)
        signer = _admin_signer()
        seal_with = _shadow_signing_key(coord)
        print(
            "\n".join(
                [
                    "Shadow mode is active. Mounting is operator-explicit; run one of these workflows:",
                    "",
                    "Linux FUSE:",
                    "  "
                    + " ".join(
                        shlex.quote(part)
                        for part in [
                            "hppr-fuse",
                            "--home",
                            os.environ.get("HPPR_HOME", "tcp+127.0.0.1:4777"),
                            "--signer",
                            signer,
                            "--root",
                            root,
                            "--mount",
                            mountpoint,
                            "--rw",
                            "--seal-with",
                            seal_with,
                        ]
                    ),
                    "  fusermount3 -u " + shlex.quote(mountpoint),
                    "",
                    "Portable NFS:",
                    "  "
                    + " ".join(
                        shlex.quote(part)
                        for part in [
                            "hppr-nfs",
                            "--home",
                            os.environ.get("HPPR_HOME", "tcp+127.0.0.1:4777"),
                            "--signer",
                            signer,
                            "--root",
                            root,
                            "--rw",
                            "--seal-with",
                            seal_with,
                            "--bind",
                            "127.0.0.1:3049",
                        ]
                    ),
                    "  mount -t nfs -o port=3049,mountport=3049,nfsvers=3,tcp,nolock 127.0.0.1:/ " + shlex.quote(mountpoint),
                    "  umount " + shlex.quote(mountpoint),
                ]
            ),
            file=sys.stderr,
        )


def cmd_deploy(args):
    if len(args) < 4:
        sys.exit("usage: havi-cli deploy <group> <api> <content-root> <content-authority>")
    group, api, content_root, content_authority = args[0], args[1], args[2], args[3]
    if not content_root.startswith("//"):
        sys.exit("error: content-root must start with //")
    if not (content_authority.startswith("V.") and content_authority.endswith(".H3")):
        sys.exit("error: content-authority must be V.<...>.H3")

    _hppr_add(
        f"//{group}/admin/deploy//{api}",
        [
            f"Content-Root: {content_root}",
            f"Content-Authority: {content_authority}",
        ],
    )


def cmd_publish(args):
    if len(args) < 2:
        sys.exit("usage: havi-cli publish <coordinate> <file>")
    coordinate, filepath = args[0], args[1]
    content_type = mimetypes.guess_type(filepath)[0] or "application/octet-stream"
    with open(filepath, "rb") as f:
        _hppr_add(coordinate, [f"Content-Type: {content_type}"], stdin=f)
    port = _debug_port()
    _run(["havi-devtools-cli", "-p", port, "navigate", f"hppr://{coordinate[2:]}"])


def cmd_publish_dir(args):
    if len(args) < 2:
        sys.exit("usage: havi-cli publish-dir <coordinate> <dir>")
    sys.exit(
        "error: publish-dir is retired; use hppr-fuse or hppr-nfs directly with --root <coordinate> --rw --seal-with ring0"
    )


BUILTIN = {
    "navigate": cmd_navigate,
    "deploy": cmd_deploy,
    "publish": cmd_publish,
    "publish-dir": cmd_publish_dir,
}

USAGE = """\
usage: havi-cli <command> [args...]
       havi-cli //<group>/<api>//<key> [--shadow] [--mount PATH]

Subcommand groups (delegate to standalone tools):
    makepad <cmd> ...    Makepad UI control (havi-makepad-cli)
    devtools <cmd> ...   Servo webview control (havi-devtools-cli)

Built-in commands:
    navigate <url>                                         Navigate HAVI to a URL
    deploy <group> <api> <content-root> <content-authority>  Write API content pointer
    publish <coordinate> <file>                            Store signed file, navigate
    publish-dir <coordinate> <dir>                         Retired. Use hppr-fuse or hppr-nfs directly

Direct open:
    //<group>/<api>//<key> [--shadow] [--mount PATH]   Open routed API document, optionally enter shadow mode

Examples:
    havi-cli makepad screenshot /tmp/out.png
    havi-cli makepad click 300 400
    havi-cli devtools eval 'document.title'
    havi-cli deploy u web //u/web// V.EXAMPLE.H3
    havi-cli publish //u/web//index.html page.html
    havi-cli //dev/hppr.forge//presentation/index.html --shadow --mount /mnt/presentation
"""


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(USAGE)
        sys.exit(0)

    cmd = args[0]
    rest = args[1:]

    if cmd == "makepad":
        os.execvp("havi-makepad-cli", ["havi-makepad-cli"] + rest)

    if cmd == "devtools":
        os.execvp("havi-devtools-cli", ["havi-devtools-cli"] + rest)

    if cmd.startswith("//"):
        cmd_open_target(args)
    elif cmd in BUILTIN:
        BUILTIN[cmd](rest)
    else:
        print(f"error: unknown command: {cmd}", file=sys.stderr)
        print(USAGE, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
