#!/usr/bin/env -S uv --quiet run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""HAVI debugger CLI - control a running HAVI browser via devtools protocol."""

import argparse
import base64
import json
import os
import queue
import socket
import sys
import threading
import time

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_CONNECTION = 3
EXIT_TIMEOUT = 4
EXIT_JS_EXCEPTION = 5

EVENT_TAB_NAVIGATED = "tabNavigated"
EVENT_PAGE_ERROR = "pageError"
EVENT_CONSOLE_API_CALL = "consoleAPICall"
EVENT_EVALUATION_RESULT = "evaluationResult"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def debug(msg):
    if os.environ.get("DEBUG"):
        print(f"[debug] {msg}", file=sys.stderr)


def port_from_env():
    val = os.environ.get("HAVI_DEVTOOLS", "6000")
    if ":" in val:
        val = val.rsplit(":", 1)[1]
    return int(val)


def output_ok(text_mode, value):
    if text_mode:
        if isinstance(value, (dict, list)):
            print(json.dumps(value, indent=2))
        elif value is not None:
            print(value)
    else:
        print(json.dumps({"ok": True, "value": value}))


def output_error(text_mode, code, error, message):
    if text_mode:
        print(f"ERROR: {message}", file=sys.stderr)
    else:
        print(json.dumps({"ok": False, "error": error, "message": message}))
    raise SystemExit(code)


# ---------------------------------------------------------------------------
# Minimal RDP client
# ---------------------------------------------------------------------------

class RDPClient:
    def __init__(self):
        self.sock = None
        self.reader = None
        self.stop_event = threading.Event()
        self.reply_queue = queue.Queue()
        self.pending = []
        self.pending_lock = threading.Lock()
        self.listeners = {}  # (actor, type) -> [callbacks]
        self.listeners_lock = threading.Lock()
        self.greeting = None

    @staticmethod
    def _read_packet(sock):
        length_buf = bytearray()
        while True:
            c = sock.recv(1)
            if not c:
                raise EOFError("connection closed")
            if c == b":":
                break
            length_buf.extend(c)
        length = int(length_buf.decode("ascii"))
        data = bytearray()
        while len(data) < length:
            chunk = sock.recv(length - len(data))
            if not chunk:
                raise EOFError("connection closed")
            data.extend(chunk)
        return json.loads(data)

    @staticmethod
    def _send_packet(sock, msg):
        data = json.dumps(msg, separators=(",", ":")).encode("utf-8")
        sock.sendall(f"{len(data)}:".encode("ascii") + data)

    def connect(self, host, port, timeout=10.0):
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.greeting = self._read_packet(self.sock)
        self.stop_event.clear()
        self.reader = threading.Thread(target=self._reader_loop, daemon=True)
        self.reader.start()
        debug(f"Connected to {host}:{port}, greeting={self.greeting}")

    def disconnect(self):
        self.stop_event.set()
        if self.sock:
            try:
                self.sock.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None
        if self.reader and self.reader.is_alive():
            self.reader.join(timeout=0.2)

    def _reader_loop(self):
        try:
            while not self.stop_event.is_set():
                packet = self._read_packet(self.sock)
                actor = packet.get("from")
                msg_type = packet.get("type")

                dispatched = False
                if actor and msg_type:
                    with self.listeners_lock:
                        callbacks = list(self.listeners.get((actor, msg_type), []))
                    for cb in callbacks:
                        try:
                            cb(packet)
                        except Exception:
                            pass
                        dispatched = True

                if not dispatched:
                    self.reply_queue.put(packet)
        except Exception:
            pass

    def send(self, msg):
        self._send_packet(self.sock, msg)

    def _pop_pending_match(self, predicate):
        with self.pending_lock:
            for i, pkt in enumerate(self.pending):
                if predicate(pkt):
                    return self.pending.pop(i)
        return None

    def send_receive(self, msg, timeout=10.0, predicate=None):
        expect_from = msg.get("to")
        if predicate is None:
            predicate = lambda p: p.get("from") == expect_from

        self.send(msg)
        deadline = time.time() + timeout

        pkt = self._pop_pending_match(predicate)
        if pkt is not None:
            return pkt

        while True:
            remaining = deadline - time.time()
            if remaining <= 0:
                return None
            try:
                pkt = self.reply_queue.get(timeout=remaining)
            except queue.Empty:
                return None

            if predicate(pkt):
                return pkt
            with self.pending_lock:
                self.pending.append(pkt)

    def add_event_listener(self, actor, event_type, callback):
        key = (actor, event_type)
        with self.listeners_lock:
            self.listeners.setdefault(key, []).append(callback)

    def remove_event_listener(self, actor, event_type, callback):
        key = (actor, event_type)
        with self.listeners_lock:
            callbacks = self.listeners.get(key)
            if not callbacks:
                return
            self.listeners[key] = [cb for cb in callbacks if cb is not callback]
            if not self.listeners[key]:
                del self.listeners[key]


# ---------------------------------------------------------------------------
# Protocol helpers
# ---------------------------------------------------------------------------

def list_tabs(client, timeout):
    reply = client.send_receive({"to": "root", "type": "listTabs"}, timeout=timeout)
    if not reply:
        return []
    return reply.get("tabs", [])


def get_root(client, timeout):
    return client.send_receive({"to": "root", "type": "getRoot"}, timeout=timeout) or {}


def get_target(client, tab_actor, timeout):
    return client.send_receive({"to": tab_actor, "type": "getTarget"}, timeout=timeout) or {}


def connect_for_console(port, timeout, text_mode=False):
    client = RDPClient()
    try:
        client.connect("localhost", port, timeout=timeout)
    except Exception as e:
        output_error(text_mode, EXIT_CONNECTION, "connection", f"failed to connect localhost:{port}: {e}")

    tabs = list_tabs(client, timeout)
    if not tabs:
        client.disconnect()
        output_error(text_mode, EXIT_CONNECTION, "connection", "no tabs open")

    target = get_target(client, tabs[0]["actor"], timeout)
    target_actor_id = target.get("actor")
    console_actor_id = target.get("consoleActor") or target.get("console")
    if not target_actor_id or not console_actor_id:
        client.disconnect()
        output_error(text_mode, EXIT_CONNECTION, "connection", "target/console actor not available")

    return client, target_actor_id, console_actor_id


# ---------------------------------------------------------------------------
# Eval core
# ---------------------------------------------------------------------------

def evaluate_js(client, console_actor_id, js, timeout=10.0):
    result_event = threading.Event()
    eval_result = {}

    def on_result(pkt):
        if "result" in pkt or "exception" in pkt or "exceptionMessage" in pkt:
            eval_result.update(pkt)
            result_event.set()

    client.add_event_listener(console_actor_id, EVENT_EVALUATION_RESULT, on_result)
    try:
        client.send({"to": console_actor_id, "type": "evaluateJSAsync", "text": js})
        if not result_event.wait(timeout=timeout):
            return None
        return eval_result
    finally:
        client.remove_event_listener(console_actor_id, EVENT_EVALUATION_RESULT, on_result)


def extract_value(result):
    if result is None:
        return None

    if result.get("exception") or result.get("exceptionMessage"):
        msg = result.get("exceptionMessage") or str(result.get("exception", "Unknown error"))
        raise RuntimeError(msg)

    value = result.get("result", result)
    if isinstance(value, dict):
        if "value" in value:
            return value["value"]
        if value.get("type") == "undefined":
            return None
        return value
    return value


def is_promise_result(result):
    if result is None:
        return False
    value = result.get("result", {})
    return isinstance(value, dict) and value.get("class") == "Promise"


def evaluate_js_await(client, console_actor_id, js, timeout=10.0):
    result = evaluate_js(client, console_actor_id, js, timeout)
    if result is None or not is_promise_result(result):
        return result

    import random
    key = f"_dbg_{random.randint(0, 2**48):012x}"
    wrapper = (
        f"window['{key}'] = undefined; "
        f"Promise.resolve(({js})).then("
        f"  function(v) {{ window['{key}'] = {{v: v}}; }},"
        f"  function(e) {{ window['{key}'] = {{e: String(e)}}; }}"
        f"); '{key}'"
    )
    evaluate_js(client, console_actor_id, wrapper, timeout)

    read_js = (
        f"(function() {{"
        f"  var r = window['{key}'];"
        f"  if (r === undefined) return void 0;"
        f"  delete window['{key}'];"
        f"  if (r.e !== undefined) throw new Error(r.e);"
        f"  return r.v;"
        f"}})()"
    )
    deadline = time.time() + timeout
    while time.time() < deadline:
        result = evaluate_js(client, console_actor_id, read_js, timeout=2.0)
        if result is not None:
            value = result.get("result", {})
            if not (isinstance(value, dict) and value.get("type") == "undefined"):
                return result
        time.sleep(0.05)
    return None


# ---------------------------------------------------------------------------
# Event formatting
# ---------------------------------------------------------------------------

def format_page_error(data):
    error = data.get("pageError", data)
    return {
        "message": error.get("errorMessage", ""),
        "sourceURL": error.get("sourceName", ""),
        "lineNumber": error.get("lineNumber"),
        "category": error.get("category", ""),
        "isWarning": error.get("warning", False),
    }


def format_console_message(data):
    msg = data.get("message", data)
    return {
        "level": msg.get("level", "log"),
        "arguments": msg.get("arguments", []),
        "sourceURL": msg.get("filename") or msg.get("sourceName", ""),
        "lineNumber": msg.get("lineNumber") or msg.get("line_number"),
    }


def setup_streaming_listeners(client, target_actor_id, console_actor_id):
    def emit(event_type, data):
        obj = {"event": event_type}
        obj.update(data)
        print(json.dumps(obj), flush=True)

    client.add_event_listener(
        target_actor_id,
        EVENT_TAB_NAVIGATED,
        lambda data: emit("tabNavigated", {
            "url": data.get("url", ""),
            "title": data.get("title"),
            "state": data.get("state", ""),
        }),
    )
    client.add_event_listener(
        console_actor_id,
        EVENT_PAGE_ERROR,
        lambda data: emit("pageError", format_page_error(data)),
    )
    client.add_event_listener(
        console_actor_id,
        EVENT_CONSOLE_API_CALL,
        lambda data: emit("consoleAPICall", format_console_message(data)),
    )


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_tabs(args):
    client = RDPClient()
    try:
        client.connect("localhost", args.port, timeout=args.timeout)
        tabs = list_tabs(client, args.timeout)
        value = [{"index": i, "url": t.get("url", ""), "title": t.get("title", "")} for i, t in enumerate(tabs)]
        output_ok(args.text, value)
    except Exception as e:
        output_error(args.text, EXIT_CONNECTION, "connection", f"failed to connect localhost:{args.port}: {e}")
    finally:
        client.disconnect()


def cmd_eval(args):
    js = args.js
    if js is None and not sys.stdin.isatty():
        js = sys.stdin.read().strip()
    if not js:
        output_error(args.text, EXIT_USAGE, "usage", "no javascript provided")

    client, _target_actor_id, console_actor_id = connect_for_console(args.port, args.timeout, args.text)
    try:
        eval_fn = evaluate_js_await if getattr(args, "await_promise", False) else evaluate_js
        result = eval_fn(client, console_actor_id, js, timeout=args.timeout)
        if result is None:
            output_error(args.text, EXIT_TIMEOUT, "timeout", f"eval timeout after {args.timeout}s")
        try:
            value = extract_value(result)
        except RuntimeError as e:
            output_error(args.text, EXIT_JS_EXCEPTION, "js_exception", str(e))
        output_ok(args.text, value)
    finally:
        client.disconnect()


def cmd_navigate(args):
    client, target_actor_id, console_actor_id = connect_for_console(args.port, args.timeout, args.text)
    nav_events = []
    client.add_event_listener(target_actor_id, EVENT_TAB_NAVIGATED, lambda data: nav_events.append(data))

    deadline = time.time() + args.timeout
    try:
        evaluate_js(client, console_actor_id, f"window.address.href = {json.dumps(args.url)}", timeout=5.0)

        while time.time() < deadline:
            for ev in nav_events:
                if ev.get("state") == "stop":
                    output_ok(args.text, ev.get("url", args.url))
                    return

            try:
                ready = extract_value(evaluate_js(client, console_actor_id, "document.readyState", timeout=2.0))
                if ready == "complete":
                    try:
                        url = extract_value(evaluate_js(client, console_actor_id, "window.address.href", timeout=2.0))
                    except Exception:
                        url = args.url
                    output_ok(args.text, url or args.url)
                    return
            except Exception:
                pass
            time.sleep(0.1)

        output_error(args.text, EXIT_TIMEOUT, "timeout", f"navigation timeout after {args.timeout}s")
    finally:
        client.disconnect()


def cmd_wait_for(args):
    client, _target_actor_id, console_actor_id = connect_for_console(args.port, args.timeout, args.text)
    deadline = time.time() + args.timeout
    interval = max(1, args.interval) / 1000.0

    try:
        while time.time() < deadline:
            try:
                value = extract_value(evaluate_js(client, console_actor_id, args.expr, timeout=5.0))
                if value:
                    output_ok(args.text, value)
                    return
            except Exception:
                pass
            time.sleep(interval)

        output_error(args.text, EXIT_TIMEOUT, "timeout", f"condition not met within {args.timeout}s")
    finally:
        client.disconnect()


def cmd_screenshot(args):
    client = RDPClient()
    try:
        client.connect("localhost", args.port, timeout=args.timeout)
        root = get_root(client, args.timeout)
        screenshot_actor = root.get("screenshotActor")
        if not screenshot_actor:
            output_error(args.text, EXIT_CONNECTION, "connection", "no screenshot actor available")

        reply = client.send_receive({"to": screenshot_actor, "type": "capture"}, timeout=args.timeout)
        if not reply:
            output_error(args.text, EXIT_TIMEOUT, "timeout", "screenshot capture timed out")
        if "error" in reply:
            output_error(args.text, EXIT_CONNECTION, "screenshot", reply["error"])

        png_data = base64.b64decode(reply["data"])
        if args.file:
            with open(args.file, "wb") as f:
                f.write(png_data)
            if args.text:
                print(f"Wrote {len(png_data)} bytes to {args.file}")
            else:
                output_ok(args.text, {
                    "file": args.file,
                    "size": len(png_data),
                    "width": reply.get("width"),
                    "height": reply.get("height"),
                })
        else:
            sys.stdout.buffer.write(png_data)
    except Exception as e:
        output_error(args.text, EXIT_CONNECTION, "connection", f"failed to connect localhost:{args.port}: {e}")
    finally:
        client.disconnect()


def cmd_watch(args):
    client = RDPClient()
    try:
        client.connect("localhost", args.port, timeout=args.timeout)
        root = get_root(client, args.timeout)
        watch_actor = root.get("watchActor")
        if not watch_actor:
            output_error(args.text, EXIT_CONNECTION, "connection", "no watch actor available")

        if args.mode is None:
            reply = client.send_receive({"to": watch_actor, "type": "getMode"}, timeout=args.timeout)
        else:
            reply = client.send_receive(
                {"to": watch_actor, "type": "setMode", "mode": args.mode},
                timeout=args.timeout,
            )

        if not reply:
            output_error(args.text, EXIT_TIMEOUT, "timeout", "watch request timed out")
        if "error" in reply:
            output_error(args.text, EXIT_CONNECTION, "watch", reply["error"])

        output_ok(args.text, reply.get("mode"))
    except Exception as e:
        output_error(args.text, EXIT_CONNECTION, "connection", f"failed to connect localhost:{args.port}: {e}")
    finally:
        client.disconnect()


def cmd_events(args):
    client, target_actor_id, console_actor_id = connect_for_console(args.port, args.timeout, args.text)
    setup_streaming_listeners(client, target_actor_id, console_actor_id)
    print(json.dumps({"event": "ready"}), flush=True)
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        client.disconnect()


def cmd_repl(args):
    client, target_actor_id, console_actor_id = connect_for_console(args.port, args.timeout, args.text)
    setup_streaming_listeners(client, target_actor_id, console_actor_id)
    print(json.dumps({"event": "ready"}), flush=True)

    try:
        for line in sys.stdin:
            js = line.strip()
            if not js:
                continue

            result = evaluate_js(client, console_actor_id, js, timeout=args.timeout)
            if result is None:
                print(json.dumps({"event": "error", "error": "timeout", "message": "eval timeout"}), flush=True)
                continue

            try:
                value = extract_value(result)
                print(json.dumps({"event": "evalResult", "value": value}), flush=True)
            except RuntimeError as e:
                print(json.dumps({"event": "error", "error": "js_exception", "message": str(e)}), flush=True)
    except (KeyboardInterrupt, EOFError):
        pass
    finally:
        client.disconnect()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="havi-devtools-cli",
        description="Control HAVI webview via DevTools protocol.",
    )
    p.add_argument("--port", "-p", type=int, default=port_from_env(),
                   help="Devtools port (default: from $HAVI_DEVTOOLS or 6000)")
    p.add_argument("--timeout", type=float, default=10.0,
                   help="Timeout in seconds (default: 10)")
    p.add_argument("--text", action="store_true",
                   help="Human-readable output instead of JSON")

    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("tabs", help="List open tabs")

    pe = sub.add_parser("eval", help="Evaluate JavaScript")
    pe.add_argument("js", nargs="?", help="JavaScript to evaluate (reads stdin if omitted)")
    pe.add_argument("--await", dest="await_promise", action="store_true",
                    help="Await Promise results before returning")

    pn = sub.add_parser("navigate", help="Navigate to URL and wait for load")
    pn.add_argument("url", help="URL to navigate to")

    pw = sub.add_parser("wait-for", help="Poll expression until truthy")
    pw.add_argument("expr", help="JavaScript expression to poll")
    pw.add_argument("--interval", type=int, default=100,
                    help="Poll interval in ms (default: 100)")

    sub.add_parser("events", help="Stream browser events as JSONL")
    sub.add_parser("repl", help="Interactive eval session (stdin line-by-line)")

    ps = sub.add_parser("screenshot", help="Capture viewport screenshot as PNG")
    ps.add_argument("file", nargs="?", help="Output file (default: stdout)")

    pwatch = sub.add_parser("watch", help="Get or set watch mode")
    pwatch.add_argument("mode", nargs="?", choices=["off", "notify", "auto", "dev"],
                        help="Mode to set (omit to query)")

    return p


def main():
    parser = build_parser()
    args = parser.parse_args()

    dispatch = {
        "tabs": cmd_tabs,
        "eval": cmd_eval,
        "navigate": cmd_navigate,
        "wait-for": cmd_wait_for,
        "events": cmd_events,
        "repl": cmd_repl,
        "screenshot": cmd_screenshot,
        "watch": cmd_watch,
    }

    if not args.cmd:
        parser.print_help(sys.stderr)
        raise SystemExit(EXIT_USAGE)

    dispatch[args.cmd](args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
