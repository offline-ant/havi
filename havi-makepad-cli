#!/usr/bin/env -S uv --quiet run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Drive HAVI's Makepad UI via the control socket.

Thin wrapper around makepad-ui-cli that adds HAVI-specific socket discovery
(HAVI_MAKEPAD_SOCKET env var) and description text.

Connects to the Unix domain socket created by `mach-havi run --control`.
Sends StudioToApp JSON lines, reads AppToStudio JSON lines.

All coordinates are in Makepad window space (0,0 = top-left of window).
For webview-level interaction (JS eval, DOM), use havi-devtools-cli.
"""

import os, sys

# Import the generic Makepad UI CLI and client library.
_tools_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "makepad", "tools")
sys.path.insert(0, _tools_dir)
import makepad_control as mc  # type: ignore[import-not-found]

# Import the CLI module (makepad-ui-cli lives next to makepad_control.py).
# Load as a Python module despite no .py extension.
import importlib.util, importlib.machinery
_cli_path = os.path.join(_tools_dir, "makepad-ui-cli")
_loader = importlib.machinery.SourceFileLoader("makepad_ui_cli", _cli_path)
_spec = importlib.util.spec_from_file_location("makepad_ui_cli", _cli_path, loader=_loader)
_cli_mod = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_cli_mod)


def main():
    p = _cli_mod.build_parser()
    p.prog = "havi-makepad-cli"
    p.description = ("Drive HAVI's Makepad UI via the control socket. "
                     "All coordinates are in Makepad window space. "
                     "For webview-level interaction, use havi-devtools-cli.")
    # HAVI uses HAVI_MAKEPAD_SOCKET as the env var convention.
    p._option_string_actions["--socket"].help = (
        "Path to Unix control socket (or set HAVI_MAKEPAD_SOCKET)")

    args = p.parse_args()
    path = (getattr(args, "socket", None)
            or os.environ.get("HAVI_MAKEPAD_SOCKET")
            or os.environ.get("MAKEPAD_SOCKET"))
    if not path:
        sys.exit("error: no socket path. Use --socket or set HAVI_MAKEPAD_SOCKET.")
    conn = mc.connect(path)
    args.func(args, conn)
    conn.close()


if __name__ == "__main__":
    main()
